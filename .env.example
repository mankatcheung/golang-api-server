APP_ENV=development

SERVER_ADDRESS=:8080
SERVER_TIMEOUT=30
GRPC_ADDRESS=:9090

ALLOWED_ORIGINS=*

DATABASE_URL=postgres://postgres:postgres@localhost:5433/users_db?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15
JWT_REFRESH_EXPIRY=7

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=600

KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC=conversions
KAFKA_GROUP_ID=api-server

LOG_LEVEL=info
LOG_FORMAT=text
LOG_KAFKA_TOPIC=app-logs
LOG_KAFKA_GROUP_ID=log-consumer

AUTH_RATE_LIMIT=10
API_RATE_LIMIT=60
